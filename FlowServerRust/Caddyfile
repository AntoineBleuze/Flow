apiflow.hd.free.fr {
    # Compression HTTP (zstd / gzip) pour les réponses JSON
    encode zstd gzip

    # Reverse proxy vers le serveur Rust (HTTP interne)
    reverse_proxy flow-server:3001 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output stderr
        format console
    }
}
